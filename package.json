{
  "name": "mts-converter",
  "productName": "MTS Converter",
  "version": "1.0.4",
  "description": "Batch-convert camera MTS/M2TS files to MP4 without losing quality",
  "author": "Anastasiya Zholudzeva",
  "main": "electron/main.js",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nstzholud/mts-converter.git"
  },
  "bugs": {
    "url": "https://github.com/nstzholud/mts-converter/issues"
  },
  "homepage": "https://github.com/nstzholud/mts-converter#readme",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "icon": "node scripts/make-icon.mjs",
    "vendor:win": "node scripts/fetch-vendor.mjs",
    "vendor:mac": "node scripts/fetch-vendor.mjs --mac",
    "build:win": "node scripts/build.mjs win",
    "build:mac": "node scripts/build.mjs mac"
  },
  "build": {
    "appId": "com.mtsconverter.app",
    "productName": "MTS Converter",
    "copyright": "MTS Converter",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "scripts/sign-mac.cjs",
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      "LICENSE",
      "THIRD-PARTY-NOTICES.txt"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "MTS-Converter-Setup-${version}.${ext}",
      "extraResources": [
        {
          "from": "vendor/win",
          "to": "vendor/win"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MTS Converter",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "category": "public.app-category.video",
      "artifactName": "MTS-Converter-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "vendor/mac",
          "to": "vendor/mac"
        }
      ]
    },
    "dmg": {
      "title": "MTS Converter",
      "window": {
        "width": 560,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 410,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3"
  }
}
